# Delphi compiler-generated binaries (safe to delete)
*.exe
*.dll
*.bpl
*.bpi
*.dcp
*.so
*.apk
*.drc
*.map
*.dres
dclBold.res
*.rsm
*.tds
*.dcu
*.lib
*.a
*.o
*.ocx

# Delphi autogenerated files (duplicated info)
*.cfg
*.hpp
*Resource.rc


# Delphi local files (user-specific info)
*.local
*.identcache
*.projdata
*.tvsconfig
*.dsk
*.delphilsp.json

# Delphi history and backups
__history/
__recovery/
*.~*

# Castalia statistics file (since XE7 Castalia is distributed with Delphi)
*.stat

# Unit test generated files
dunitx-results.xml
UnitTest/coverage_report/
UnitTest/Win32/
UnitTest/cobertura.xml
UnitTest/codecov.json
UnitTest/codecov.exe
UnitTest/test_codecov.json
UnitTest/matrix_*.log
# per-project build output (TMS Smart Setup builds packages in place when given a local folder)
packages/*/Win32/
packages/*/Win64/
TestInsightSettings.ini

# Example app data files
*.db
BoldDemo.xml

# Windows nul device file accidentally created
nul
# MkDocs generated site
site/

# Decompiled Help/BfD.chm, input for Tools/chm2mkdocs.py
.chm-decompiled/
__pycache__/
