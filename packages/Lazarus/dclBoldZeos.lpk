<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <Name Value="dclBoldZeos"/>
    <Type Value="DesignTime"/>
    <Author Value="Bold for Delphi contributors"/>
    <CompilerOptions>
      <Version Value="11"/>
      <SearchPaths>
        <IncludeFiles Value="../../Source/Common/Include"/>
        <OtherUnitFiles Value="../../Source/Persistence/Zeos/IDELazarus"/>
        <UnitOutputDirectory Value="lib/dclBoldZeos/$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
      <Other>
        <CustomOptions Value="-Mdelphiunicode"/>
      </Other>
    </CompilerOptions>
    <Description Value="Bold for Delphi, design time for Lazarus: puts TBoldDatabaseAdapterZeos on the component palette."/>
    <License Value="MIT"/>
    <Version Major="26" Minor="9" Release="1"/>
    <Files>
      <Item>
        <Filename Value="../../Source/Persistence/Zeos/IDELazarus/boldzeoslazarusreg.pas"/>
        <HasRegisterProc Value="True"/>
        <UnitName Value="BoldZeosLazarusReg"/>
      </Item>
    </Files>
    <RequiredPkgs>
      <Item>
        <PackageName Value="dclBold"/>
        <DefaultFilename Value="dclBold.lpk" Prefer="True"/>
      </Item>
      <Item>
        <PackageName Value="BoldZeos"/>
        <DefaultFilename Value="BoldZeos.lpk" Prefer="True"/>
      </Item>
      <Item>
        <PackageName Value="Bold"/>
        <DefaultFilename Value="Bold.lpk" Prefer="True"/>
      </Item>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
  </Package>
</CONFIG>
