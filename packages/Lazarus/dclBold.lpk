<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <Name Value="dclBold"/>
    <Type Value="DesignTime"/>
    <Author Value="Bold for Delphi contributors"/>
    <CompilerOptions>
      <Version Value="11"/>
      <SearchPaths>
        <IncludeFiles Value="../../Source/Common/Include"/>
        <OtherUnitFiles Value="../../Source/Common/IDELazarus;../../Source/Common/IDE"/>
        <UnitOutputDirectory Value="lib/dclBold/$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
      <Other>
        <CustomOptions Value="-Mdelphiunicode"/>
      </Other>
    </CompilerOptions>
    <Description Value="Bold for Delphi, design time for Lazarus: puts Bold's non-visual components (handles, model, persistence handles, TBoldDataSet) on the component palette."/>
    <License Value="MIT"/>
    <Version Major="26" Minor="9" Release="1"/>
    <Files>
      <Item>
        <Filename Value="../../Source/Common/IDELazarus/boldlazarusreg.pas"/>
        <HasRegisterProc Value="True"/>
        <UnitName Value="BoldLazarusReg"/>
      </Item>
      <Item>
        <Filename Value="../../Source/Common/IDE/boldideconsts.pas"/>
        <UnitName Value="BoldIDEConsts"/>
      </Item>
    </Files>
    <RequiredPkgs>
      <Item>
        <PackageName Value="BoldLCL"/>
        <DefaultFilename Value="BoldLCL.lpk" Prefer="True"/>
      </Item>
      <Item>
        <PackageName Value="Bold"/>
        <DefaultFilename Value="Bold.lpk" Prefer="True"/>
      </Item>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
  </Package>
</CONFIG>
