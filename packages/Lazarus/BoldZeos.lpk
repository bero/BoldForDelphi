<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <Name Value="BoldZeos"/>
    <Type Value="RunTime"/>
    <Author Value="Bold for Delphi contributors"/>
    <CompilerOptions>
      <Version Value="11"/>
      <SearchPaths>
        <IncludeFiles Value="../../Source/Common/Include"/>
        <OtherUnitFiles Value="../../Source/Persistence/Zeos"/>
        <UnitOutputDirectory Value="lib/BoldZeos/$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
      <Other>
        <CustomOptions Value="-Mdelphiunicode"/>
      </Other>
    </CompilerOptions>
    <Description Value="Bold for Delphi, the database adapter for Zeos (ZeosLib 8.0): TBoldDatabaseAdapterZeos, which Bold uses for SQL databases under Free Pascal."/>
    <License Value="MIT"/>
    <Version Major="26" Minor="9" Release="1"/>
    <Files>
      <Item>
        <Filename Value="../../Source/Persistence/Zeos/bolddatabaseadapterzeos.pas"/>
        <UnitName Value="BoldDatabaseAdapterZeos"/>
      </Item>
      <Item>
        <Filename Value="../../Source/Persistence/Zeos/boldzeosinterfaces.pas"/>
        <UnitName Value="BoldZeosInterfaces"/>
      </Item>
    </Files>
    <RequiredPkgs>
      <Item>
        <PackageName Value="Bold"/>
        <DefaultFilename Value="Bold.lpk" Prefer="True"/>
      </Item>
      <Item>
        <PackageName Value="zcomponent"/>
      </Item>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
  </Package>
</CONFIG>
