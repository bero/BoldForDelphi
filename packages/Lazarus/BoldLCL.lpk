<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <Name Value="BoldLCL"/>
    <Type Value="RunTime"/>
    <Author Value="Bold for Delphi contributors"/>
    <CompilerOptions>
      <Version Value="11"/>
      <SearchPaths>
        <IncludeFiles Value="../../Source/Common/Include"/>
        <OtherUnitFiles Value="../../Source/Common/EnvironmentLCL"/>
        <UnitOutputDirectory Value="lib/BoldLCL/$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
      <Other>
        <CustomOptions Value="-Mdelphiunicode"/>
      </Other>
    </CompilerOptions>
    <Description Value="Bold for Delphi, the LCL side of the runtime: BoldEnvironmentLCL, which drains Bold's display queue from the LCL's idle handling and shows LCL dialogs."/>
    <License Value="MIT"/>
    <Version Major="26" Minor="9" Release="1"/>
    <Files>
      <Item>
        <Filename Value="../../Source/Common/EnvironmentLCL/boldenvironmentlcl.pas"/>
        <UnitName Value="BoldEnvironmentLCL"/>
      </Item>
    </Files>
    <RequiredPkgs>
      <Item>
        <PackageName Value="Bold"/>
        <DefaultFilename Value="Bold.lpk" Prefer="True"/>
      </Item>
      <Item>
        <PackageName Value="LCLBase"/>
      </Item>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
  </Package>
</CONFIG>
