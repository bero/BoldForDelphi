<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <Name Value="BoldLCL"/>
    <Type Value="RunTime"/>
    <Author Value="Bold for Delphi contributors"/>
    <CompilerOptions>
      <Version Value="11"/>
      <SearchPaths>
        <IncludeFiles Value="../../Source/Common/Include"/>
        <OtherUnitFiles Value="../../Source/Common/EnvironmentLCL;../../Source/ObjectSpace/UtilsGUI/LCL"/>
        <UnitOutputDirectory Value="lib/BoldLCL/$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
      <Other>
        <CustomOptions Value="-Mdelphiunicode -vm3018,4104,4105,5033"/>
      </Other>
    </CompilerOptions>
    <Description Value="Bold for Delphi, the LCL side of the runtime: BoldEnvironmentLCL, which drains Bold's display queue from the LCL's idle handling and shows LCL dialogs, BoldExceptionLogLCL, which logs the exceptions of the LCL's message loop with their call stacks, and Bold's OCL editor as an LCL dialog."/>
    <License Value="MIT"/>
    <Version Major="26" Minor="9" Release="1"/>
    <Files>
      <Item>
        <Filename Value="../../Source/Common/EnvironmentLCL/boldenvironmentlcl.pas"/>
        <UnitName Value="BoldEnvironmentLCL"/>
      </Item>
      <Item>
        <Filename Value="../../Source/Common/EnvironmentLCL/boldexceptionloglcl.pas"/>
        <UnitName Value="BoldExceptionLogLCL"/>
      </Item>
      <Item>
        <Filename Value="../../Source/ObjectSpace/UtilsGUI/LCL/boldoclexpressiondialoglcl.pas"/>
        <UnitName Value="BoldOclExpressionDialogLCL"/>
      </Item>
    </Files>
    <RequiredPkgs>
      <Item>
        <PackageName Value="Bold"/>
        <DefaultFilename Value="Bold.lpk" Prefer="True"/>
      </Item>
      <Item>
        <PackageName Value="LCLBase"/>
      </Item>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
  </Package>
</CONFIG>
