{$IFDEF FPC}{$mode delphiunicode}{$ENDIF}
unit Test.BoldModelDocument;

{ Tests of the standalone model editor's part without user interface (#128),
  the same source for the Delphi (DUnitX) and the Free Pascal (FPCUnit) test
  programs, through BoldTestFramework.

  The models are two of the repository's: the Invoicing example's
  (examples/Compound/Invoicing/Model) and the Master-Detail demos'
  (examples/Shared). Their business classes were generated by the Delphi
  IDE and are committed next to them, so the generator's output can be
  compared with those files. }

interface

uses
  BoldTestFramework,
  BoldModelDocument;

type
  TTestBoldModelDocument = class(TBoldTestCase)
  private
    FTempFolder: string;
    // For the methods WillRaise calls
    FDocument: TBoldModelDocument;
    FFormFile: string;
    procedure LoadTheForm;
  protected
    procedure SetUp; override;
    procedure TearDown; override;
  published
    procedure TestOpenReadsTheClasses;
    // A file the IDE saved comes back the same. Invoicing.bld was written by
    // hand and comes back in the converter's form (persistence=, no default
    // tagged values), which then stays the same.
    procedure TestSaveGivesTheDemoFileBack;
    procedure TestSavingTheInvoicingModelTwiceGivesTheSameFile;
    // The generated unit and interface include are what the IDE generated
    procedure TestGeneratedCodeIsWhatTheIDEGenerated;
    // An include file with methods is written once; implemented methods stay
    procedure TestGenerateKeepsAnExistingMethodFile;
    // A changed model is saved with the change
    procedure TestSaveKeepsAChange;
    // The type names (a model's attribute types to Delphi classes and units)
    // are Bold's until the TBoldTypeNameHandle of a form is read, as the IDE
    // takes them from the handle on the form of its TBoldModel. The form is
    // the CustomAttributes example's, which the IDE wrote.
    procedure TestGenerateUsesTheTypeNamesOfAForm;
    procedure TestTypeNamesStayWhenAnotherModelIsOpened;
    // A form that has no handle, or more than one, is refused; the type names
    // read before stay
    procedure TestAFormWithoutATypeNameHandleIsRefused;
    procedure TestAFormWithTwoTypeNameHandlesIsRefused;
  end;

implementation

uses
  SysUtils,
  Classes,
  BoldUMLModel,
  ModelEditorTestSupport;

const
  // The files the Delphi IDE generated from Invoicing.bld
  cGeneratedFiles: array[0..1] of string = ('InvoicingClasses.pas', 'InvoicingClasses_Interface.inc');
  cInvoicingModel = 'examples/Compound/Invoicing/Model/Invoicing.bld';
  // A form with a TBoldTypeNameHandle that maps the model type Coordinate to
  // TBACoordinate in the unit BACoordinate
  cTypeNamesForm = 'examples/Simple/ObjectSpace/CustomAttributes/MainForm.dfm';
  // A form with no TBoldTypeNameHandle
  cFormWithoutTypeNames = 'Tools/ModelEditor/Core/BoldModelEditorData.dfm';
  cFormWithTwoTypeNameHandles =
    'object dmTwo: TDataModule'#13#10 +
    '  object TypeNamesA: TBoldTypeNameHandle'#13#10 +
    '    Left = 8'#13#10 +
    '    Top = 8'#13#10 +
    '  end'#13#10 +
    '  object TypeNamesB: TBoldTypeNameHandle'#13#10 +
    '    Left = 8'#13#10 +
    '    Top = 64'#13#10 +
    '  end'#13#10 +
    'end'#13#10;

function ClassNamed(AModel: TUMLModel; const AName: string): TUMLClass;
var
  i: Integer;
begin
  for i := 0 to AModel.Classes.Count - 1 do
    if AModel.Classes[i].Name = AName then
      Exit(AModel.Classes[i]);
  Result := nil;
end;

function AttributeNamed(AClass: TUMLClass; const AName: string): TUMLAttribute;
var
  i: Integer;
begin
  for i := 0 to AClass.Feature.Count - 1 do
    if (AClass.Feature[i] is TUMLAttribute) and (AClass.Feature[i].Name = AName) then
      Exit(TUMLAttribute(AClass.Feature[i]));
  Result := nil;
end;

{ Opens the Invoicing model with Address.Street of the type Coordinate, which
  only the CustomAttributes example's type names know }
procedure OpenInvoicingWithACoordinate(ADocument: TBoldModelDocument);
var
  Street: TUMLAttribute;
begin
  ADocument.Open(RepositoryFile(cInvoicingModel));
  Street := AttributeNamed(ClassNamed(ADocument.UMLModel, 'Address'), 'Street');
  Assert.IsNotNull(Street, 'the attribute Address.Street');
  Street.typeName := 'Coordinate';
end;

procedure WriteText(const AFileName, AText: string);
var
  Lines: TStringList;
begin
  Lines := TStringList.Create;
  try
    Lines.Text := AText;
    Lines.SaveToFile(AFileName);
  finally
    Lines.Free;
  end;
end;

{ The text without the line that holds the time it was generated }
function WithoutGeneratedLine(const AText: string): string;
var
  Lines: TStringList;
  i: Integer;
begin
  Lines := TStringList.Create;
  try
    Lines.Text := AText;
    for i := Lines.Count - 1 downto 0 do
      if Pos('(* Generated ', Lines[i]) = 1 then
        Lines.Delete(i);
    Result := Lines.Text;
  finally
    Lines.Free;
  end;
end;

{ The first line where two texts differ, for a failure message }
function FirstDifference(const AExpected, AActual: string): string;
var
  Expected, Actual: TStringList;
  i: Integer;
begin
  Result := '';
  Expected := TStringList.Create;
  Actual := TStringList.Create;
  try
    Expected.Text := AExpected;
    Actual.Text := AActual;
    for i := 0 to Expected.Count - 1 do
      if (i >= Actual.Count) or (Expected[i] <> Actual[i]) then
      begin
        if i < Actual.Count then
          Result := Format('line %d: expected "%s", got "%s"', [i + 1, Expected[i], Actual[i]])
        else
          Result := Format('line %d: expected "%s", got the end', [i + 1, Expected[i]]);
        Exit;
      end;
    if Actual.Count > Expected.Count then
      Result := Format('line %d: expected the end, got "%s"', [Expected.Count + 1, Actual[Expected.Count]]);
  finally
    Actual.Free;
    Expected.Free;
  end;
end;

procedure AssertSameText(const AExpected, AActual, AWhat: string);
begin
  if AExpected <> AActual then
    Assert.Fail(AWhat + ' differs, ' + FirstDifference(AExpected, AActual));
end;

{ TTestBoldModelDocument }

procedure TTestBoldModelDocument.SetUp;
begin
  inherited;
  FTempFolder := NewTempFolder('BoldModelDocument');
end;

procedure TTestBoldModelDocument.TearDown;
begin
  DeleteFolder(FTempFolder);
  inherited;
end;

procedure TTestBoldModelDocument.TestOpenReadsTheClasses;
var
  Document: TBoldModelDocument;
  Names: TStringList;
  i: Integer;
begin
  Document := TBoldModelDocument.Create;
  Names := TStringList.Create;
  try
    Document.Open(RepositoryFile('examples/Compound/Invoicing/Model/Invoicing.bld'));
    Assert.AreEqual('Invoicing', Document.UMLModel.Name, 'the model''s name');
    for i := 0 to Document.UMLModel.Classes.Count - 1 do
      Names.Add(Document.UMLModel.Classes[i].Name);
    Names.Sort;
    Assert.IsTrue(Names.IndexOf('Customer') >= 0, 'a class Customer: ' + Names.CommaText);
    Assert.IsTrue(Names.IndexOf('Invoice') >= 0, 'a class Invoice: ' + Names.CommaText);
    Assert.IsTrue(Names.IndexOf('InvoiceLine') >= 0, 'a class InvoiceLine: ' + Names.CommaText);
  finally
    Names.Free;
    Document.Free;
  end;
end;

procedure TTestBoldModelDocument.TestSaveGivesTheDemoFileBack;
var
  Document: TBoldModelDocument;
  Original, Saved: string;
begin
  Original := RepositoryFile('examples/Shared/DemoModel.bld');
  Saved := IncludeTrailingPathDelimiter(FTempFolder) + 'DemoModel.bld';
  Document := TBoldModelDocument.Create;
  try
    Document.Open(Original);
    Document.SaveAs(Saved);
  finally
    Document.Free;
  end;
  AssertSameText(TextOf(Original), TextOf(Saved), 'the saved DemoModel.bld');
end;

procedure TTestBoldModelDocument.TestSavingTheInvoicingModelTwiceGivesTheSameFile;
var
  Document: TBoldModelDocument;
  First, Second: string;
begin
  First := IncludeTrailingPathDelimiter(FTempFolder) + 'First.bld';
  Second := IncludeTrailingPathDelimiter(FTempFolder) + 'Second.bld';
  Document := TBoldModelDocument.Create;
  try
    Document.Open(RepositoryFile('examples/Compound/Invoicing/Model/Invoicing.bld'));
    Document.SaveAs(First);
    Document.Open(First);
    Document.SaveAs(Second);
  finally
    Document.Free;
  end;
  AssertSameText(TextOf(First), TextOf(Second), 'the Invoicing model saved a second time');
end;

procedure TTestBoldModelDocument.TestGeneratedCodeIsWhatTheIDEGenerated;
var
  Document: TBoldModelDocument;
  ModelFolder: string;
  Name: string;
  i: Integer;
begin
  ModelFolder := ExtractFilePath(RepositoryFile('examples/Compound/Invoicing/Model/Invoicing.bld'));
  Document := TBoldModelDocument.Create;
  try
    Document.Open(ModelFolder + 'Invoicing.bld');
    Document.GenerateCode(FTempFolder);
  finally
    Document.Free;
  end;
  for i := Low(cGeneratedFiles) to High(cGeneratedFiles) do
  begin
    Name := cGeneratedFiles[i];
    Assert.IsTrue(FileExists(IncludeTrailingPathDelimiter(FTempFolder) + Name), Name + ' is written');
    AssertSameText(WithoutGeneratedLine(TextOf(ModelFolder + Name)),
      WithoutGeneratedLine(TextOf(IncludeTrailingPathDelimiter(FTempFolder) + Name)), Name);
  end;
end;

procedure TTestBoldModelDocument.TestGenerateKeepsAnExistingMethodFile;
const
  cMarker = '// implemented by hand';
var
  Document: TBoldModelDocument;
  MethodFile: string;
  Lines: TStringList;
begin
  Document := TBoldModelDocument.Create;
  try
    Document.Open(RepositoryFile('examples/Compound/Invoicing/Model/Invoicing.bld'));
    Document.GenerateCode(FTempFolder);
    MethodFile := IncludeTrailingPathDelimiter(FTempFolder) + 'InvoicingClasses.inc';
    Assert.IsTrue(FileExists(MethodFile), 'the include file with the methods is written');
    Lines := TStringList.Create;
    try
      Lines.LoadFromFile(MethodFile);
      Lines.Add(cMarker);
      Lines.SaveToFile(MethodFile);
    finally
      Lines.Free;
    end;
    Document.GenerateCode(FTempFolder);
  finally
    Document.Free;
  end;
  Assert.IsTrue(Pos(cMarker, TextOf(MethodFile)) > 0, 'the methods written by hand are still there');
end;

procedure TTestBoldModelDocument.TestSaveKeepsAChange;
var
  Document: TBoldModelDocument;
  Saved: string;
  Customer: TUMLClass;
  i: Integer;
begin
  Saved := IncludeTrailingPathDelimiter(FTempFolder) + 'Changed.bld';
  Document := TBoldModelDocument.Create;
  try
    Document.Open(RepositoryFile('examples/Compound/Invoicing/Model/Invoicing.bld'));
    Customer := nil;
    for i := 0 to Document.UMLModel.Classes.Count - 1 do
      if Document.UMLModel.Classes[i].Name = 'Customer' then
        Customer := Document.UMLModel.Classes[i];
    Assert.IsNotNull(Customer, 'the class Customer');
    Customer.Name := 'Client';
    Document.SaveAs(Saved);
  finally
    Document.Free;
  end;
  Document := TBoldModelDocument.Create;
  try
    Document.Open(Saved);
    Assert.IsTrue(Pos('"Client"', TextOf(Saved)) > 0, 'the file has the new name');
    Customer := nil;
    for i := 0 to Document.UMLModel.Classes.Count - 1 do
      if Document.UMLModel.Classes[i].Name = 'Client' then
        Customer := Document.UMLModel.Classes[i];
    Assert.IsNotNull(Customer, 'read back, the class is called Client');
  finally
    Document.Free;
  end;
end;

procedure TTestBoldModelDocument.LoadTheForm;
begin
  FDocument.LoadTypeNames(FFormFile);
end;

procedure TTestBoldModelDocument.TestGenerateUsesTheTypeNamesOfAForm;
var
  BoldsFolder, FormsFolder, Interface_: string;
begin
  BoldsFolder := IncludeTrailingPathDelimiter(FTempFolder) + 'Bolds';
  FormsFolder := IncludeTrailingPathDelimiter(FTempFolder) + 'Forms';
  ForceDirectories(BoldsFolder);
  ForceDirectories(FormsFolder);
  FDocument := TBoldModelDocument.Create;
  try
    OpenInvoicingWithACoordinate(FDocument);
    Assert.AreEqual('', FDocument.TypeNamesFile, 'Bold''s type names at first');
    FDocument.GenerateCode(BoldsFolder);
    FDocument.LoadTypeNames(RepositoryFile(cTypeNamesForm));
    Assert.AreEqual(RepositoryFile(cTypeNamesForm), FDocument.TypeNamesFile, 'the form the type names are from');
    FDocument.GenerateCode(FormsFolder);
  finally
    FreeAndNil(FDocument);
  end;
  Interface_ := TextOf(IncludeTrailingPathDelimiter(BoldsFolder) + 'InvoicingClasses_Interface.inc');
  Assert.IsFalse(Pos('TBACoordinate', Interface_) > 0, 'Bold''s type names do not know Coordinate');
  Interface_ := TextOf(IncludeTrailingPathDelimiter(FormsFolder) + 'InvoicingClasses_Interface.inc');
  Assert.IsTrue(Pos('_Get_M_Street: TBACoordinate;', Interface_) > 0, 'the form''s type names make Street a TBACoordinate');
  Assert.IsTrue(Pos('  BACoordinate,', Interface_) > 0, 'and add its unit to the uses clause');
end;

procedure TTestBoldModelDocument.TestTypeNamesStayWhenAnotherModelIsOpened;
var
  Folder: string;
begin
  Folder := IncludeTrailingPathDelimiter(FTempFolder) + 'Code';
  ForceDirectories(Folder);
  FDocument := TBoldModelDocument.Create;
  try
    FDocument.LoadTypeNames(RepositoryFile(cTypeNamesForm));
    FDocument.Open(RepositoryFile('examples/Shared/DemoModel.bld'));
    OpenInvoicingWithACoordinate(FDocument);
    Assert.AreEqual(RepositoryFile(cTypeNamesForm), FDocument.TypeNamesFile, 'the form the type names are from');
    FDocument.GenerateCode(Folder);
  finally
    FreeAndNil(FDocument);
  end;
  Assert.IsTrue(Pos('_Get_M_Street: TBACoordinate;',
    TextOf(IncludeTrailingPathDelimiter(Folder) + 'InvoicingClasses_Interface.inc')) > 0,
    'the type names of the form are still used');
end;

procedure TTestBoldModelDocument.TestAFormWithoutATypeNameHandleIsRefused;
begin
  FDocument := TBoldModelDocument.Create;
  try
    FDocument.LoadTypeNames(RepositoryFile(cTypeNamesForm));
    FFormFile := RepositoryFile(cFormWithoutTypeNames);
    Assert.WillRaise(LoadTheForm, EBoldModelDocument, 'a form without a TBoldTypeNameHandle');
    Assert.AreEqual(RepositoryFile(cTypeNamesForm), FDocument.TypeNamesFile, 'the type names read before stay');
    Assert.AreEqual('BACoordinate', FDocument.Model.TypeNameDictionary.ExactMappingForModelName['Coordinate'].BoldUnitName,
      'the unit of Coordinate');
  finally
    FreeAndNil(FDocument);
  end;
end;

procedure TTestBoldModelDocument.TestAFormWithTwoTypeNameHandlesIsRefused;
begin
  FFormFile := IncludeTrailingPathDelimiter(FTempFolder) + 'Two.dfm';
  WriteText(FFormFile, cFormWithTwoTypeNameHandles);
  FDocument := TBoldModelDocument.Create;
  try
    Assert.WillRaise(LoadTheForm, EBoldModelDocument, 'a form with two TBoldTypeNameHandles');
    Assert.AreEqual('', FDocument.TypeNamesFile, 'still Bold''s type names');
  finally
    FreeAndNil(FDocument);
  end;
end;

initialization
  BoldRegisterTest(TTestBoldModelDocument);

end.
