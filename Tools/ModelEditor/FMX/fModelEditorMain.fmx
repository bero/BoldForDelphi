  object alActions: TActionList
    OnUpdate = alActionsUpdate
    Left = 680
    Top = 120
    object actNew: TAction
      Text = '&New'
      Hint = 'A new, empty model'
      ShortCut = 16462
      OnExecute = actNewExecute
    end
    object actOpen: TAction
      Text = '&Open...'
      Hint = 'Open a model file (.bld)'
      ShortCut = 16463
      OnExecute = actOpenExecute
    end
    object actSave: TAction
      Text = '&Save'
      Hint = 'Save the model to its file'
      ShortCut = 16467
      OnExecute = actSaveExecute
    end
    object actSaveAs: TAction
      Text = 'Save &as...'
      Hint = 'Save the model to another file'
      ShortCut = 24659
      OnExecute = actSaveAsExecute
    end
    object actGenerate: TAction
      Text = '&Generate code...'
      Hint = 'Generate the business classes of the model into a folder'
      ShortCut = 16455
      OnExecute = actGenerateExecute
    end
    object actTypeNames: TAction
      Text = '&Type names from form...'
      Hint =
        'Generate code with the attribute types of the TBoldTypeNameHandle' +
        ' on a form (.dfm, .lfm)'
      OnExecute = actTypeNamesExecute
    end
    object actExit: TAction
      Text = 'E&xit'
      Hint = 'Close the model editor'
      OnExecute = actExitExecute
    end
    object actAddClass: TAction
      Text = 'Add class'
      Hint = 'Add a class to the model'
      OnExecute = actAddClassExecute
    end
    object actDeleteClass: TAction
      Text = 'Delete class'
      Hint = 'Delete the selected class; its subclasses get its superclass'
      OnExecute = actDeleteClassExecute
    end
    object actAddAttribute: TAction
      Text = 'Add attribute'
      Hint = 'Add an attribute to the selected class'
      OnExecute = actAddAttributeExecute
    end
    object actDeleteAttribute: TAction
      Text = 'Delete attribute'
      Hint = 'Delete the selected attribute'
      OnExecute = actDeleteAttributeExecute
    end
    object actValidate: TAction
      Text = 'Check consistency'
      Hint = 'Check the model as Bold''s model editor does; double-click a finding to select what it is about'
      OnExecute = actValidateExecute
    end
  end
