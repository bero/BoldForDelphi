<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <ProjectOptions>
    <Version Value="12"/>
    <General>
      <Flags>
        <MainUnitHasCreateFormStatements Value="False"/>
        <MainUnitHasTitleStatement Value="False"/>
        <MainUnitHasScaledStatement Value="False"/>
      </Flags>
      <SessionStorage Value="InProjectDir"/>
      <Title Value="InvoicingZeos"/>
      <UseAppBundle Value="False"/>
      <ResourceType Value="res"/>
    </General>
    <BuildModes>
      <Item Name="Default" Default="True"/>
    </BuildModes>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
    <RunParams>
      <FormatVersion Value="2"/>
    </RunParams>
    <RequiredPackages>
      <Item>
        <PackageName Value="BoldZeos"/>
        <DefaultFilename Value="../../../../packages/Lazarus/BoldZeos.lpk" Prefer="True"/>
      </Item>
      <Item>
        <PackageName Value="Bold"/>
        <DefaultFilename Value="../../../../packages/Lazarus/Bold.lpk" Prefer="True"/>
      </Item>
    </RequiredPackages>
    <Units>
      <Unit>
        <Filename Value="InvoicingZeos.lpr"/>
        <IsPartOfProject Value="True"/>
      </Unit>
      <Unit>
        <Filename Value="InvoicingSystemZeos.pas"/>
        <IsPartOfProject Value="True"/>
      </Unit>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <Target>
      <Filename Value="bin/InvoicingZeos"/>
    </Target>
    <SearchPaths>
      <IncludeFiles Value="../Model;$(ProjOutDir)"/>
      <OtherUnitFiles Value="../Model;../Tests"/>
      <UnitOutputDirectory Value="lib/$(TargetCPU)-$(TargetOS)"/>
    </SearchPaths>
    <Other>
      <CustomOptions Value="-Mdelphiunicode"/>
    </Other>
  </CompilerOptions>
</CONFIG>
