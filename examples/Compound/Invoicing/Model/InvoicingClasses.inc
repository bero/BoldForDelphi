// Method bodies of the Invoicing model. This file is hand-written and survives
// regeneration; the declarations live in Invoicing.bld and are regenerated into
// InvoicingClasses_Interface.inc.
//
// Rule of thumb used here: a method raises for a STATE error (posting twice,
// changing a posted invoice, invoicing an inactive customer), while VALUE
// errors (quantity 0, negative VAT) are left to the model constraints, which
// the GUI shows next to the field.
{$INCLUDE InvoicingClasses_Interface.inc}

resourcestring
  sCustomerInactive = 'Customer %s is inactive and cannot be invoiced';
  sInvoiceAlreadyPosted = 'Invoice %s is already posted';
  sInvoiceHasNoLines = 'An invoice without lines cannot be posted';
  sInvoiceNotPosted = 'Payments can only be recorded on a posted invoice';
  sPostedInvoiceIsFrozen = 'Invoice %s is posted and cannot be changed';
  sPostedInvoiceCannotBeDeleted = 'Invoice %s is posted and cannot be deleted';

const
  cDefaultPaymentTermDays = 14;

procedure CopyAddress(ASource, ATarget: TAddress);
begin
  ATarget.Street := ASource.Street;
  ATarget.PostalCode := ASource.PostalCode;
  ATarget.City := ASource.City;
  ATarget.Country := ASource.Country;
end;

{ TCompanySettings }

class function TCompanySettings.Instance(ASystem: TBoldSystem): TCompanySettings;
var
  All: TBoldObjectList;
begin
  All := ASystem.ClassByExpressionName['CompanySettings'];
  if All.Count > 0 then
    Result := All[0] as TCompanySettings
  else
    Result := TCompanySettings.Create(ASystem);
end;

function TCompanySettings.AllocateInvoiceNumber: Integer;
begin
  Result := NextInvoiceNumber;
  NextInvoiceNumber := Result + 1;
end;

function TCompanySettings.AllocateCustomerNumber: Integer;
begin
  Result := NextCustomerNumber;
  NextCustomerNumber := Result + 1;
end;

procedure TCompanySettings.CompleteCreate;
begin
  inherited;
  NextInvoiceNumber := 1;
  NextCustomerNumber := 1;
  DefaultPaymentTermDays := cDefaultPaymentTermDays;
  Address := TAddress.Create(BoldSystem);
end;

{ TCustomer }

function TCustomer.NewInvoice: TInvoice;
var
  Days: Integer;
begin
  if not IsActive then
    raise EBold.CreateFmt(sCustomerInactive, [Name]);

  Result := TInvoice.Create(BoldSystem);
  Result.Customer := Self;
  if Assigned(BillingAddress) then
    CopyAddress(BillingAddress, Result.BillingAddress);

  // PaymentTermDays 0 means "use the company default".
  Days := PaymentTermDays;
  if Days <= 0 then
    Days := TCompanySettings.Instance(BoldSystem).DefaultPaymentTermDays;
  Result.DueDate := Result.InvoiceDate + Days;
end;

procedure TCustomer.CompleteCreate;
begin
  inherited;
  IsActive := True;
  Number := TCompanySettings.Instance(BoldSystem).AllocateCustomerNumber;
  BillingAddress := TAddress.Create(BoldSystem);
end;

{ TInvoice }

function TInvoice.AddLine(AProduct: TProduct; AQuantity: Double): TInvoiceLine;
begin
  if IsPosted then
    raise EBold.CreateFmt(sPostedInvoiceIsFrozen, [AsString]);

  Result := TInvoiceLine.Create(BoldSystem);
  Result.Quantity := AQuantity;
  // Snapshot the product, so a later price or VAT change leaves the line alone.
  if Assigned(AProduct) then
  begin
    Result.Product := AProduct;
    Result.Description := AProduct.Name;
    Result.UnitPrice := AProduct.UnitPrice;
    if Assigned(AProduct.VatRate) then
      Result.VatPercent := AProduct.VatRate.Percent;
  end;
  Lines.Add(Result);
end;

function TInvoice.AddPayment(AAmount: Currency; APaymentDate: TDateTime): TPayment;
begin
  if not IsPosted then
    raise EBold.Create(sInvoiceNotPosted);

  Result := TPayment.Create(BoldSystem);
  Result.Amount := AAmount;
  Result.PaymentDate := APaymentDate;
  Payments.Add(Result);
end;

procedure TInvoice.Post;
begin
  if IsPosted then
    raise EBold.CreateFmt(sInvoiceAlreadyPosted, [AsString]);

  if Lines.Count = 0 then
    raise EBold.Create(sInvoiceHasNoLines);

  // Allocate only after the checks, so a refused post leaves no hole in the
  // number series.
  Number := TCompanySettings.Instance(BoldSystem).AllocateInvoiceNumber;
  IsPosted := True;
end;

function TInvoice.MayDelete: Boolean;
begin
  Result := inherited MayDelete and not IsPosted;
  if not Result then
    SetBoldLastFailureReason(TBoldFailureReason.CreateFmt(sPostedInvoiceCannotBeDeleted, [AsString], Self));
end;

procedure TInvoice.CompleteCreate;
begin
  inherited;
  InvoiceDate := Date;
  DueDate := Date;
  BillingAddress := TAddress.Create(BoldSystem);
end;
